# 1. Supabase Credentials (from https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. Resend Email Delivery (from https://resend.com -> API Keys)
# Free tier gives 3,000 emails/month, perfect for client inquiries
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_RECEIVER_EMAIL=raghurajeshc5@gmail.com
CONTACT_SENDER_EMAIL=onboarding@resend.dev

# 3. Admin Dashboard Protection
ADMIN_SECRET_KEY=raghu-edit-2026

# 4. App URL (for Open Graph and SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
